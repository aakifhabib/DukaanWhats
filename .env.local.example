# Supabase project credentials (keep server-only keys private)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Older Supabase projects can use this instead of the publishable-key variable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_PUBLIC_ANON_KEY

# Server-side only (admin user data + validated store analytics). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated Supabase Auth email addresses allowed into /admin/payments.
ADMIN_EMAILS=your-admin@example.com

# Free built-in guide is the default and makes no external AI requests.
ASSISTANT_AI_PROVIDER=free
# Optional Gemini provider. Set ASSISTANT_AI_PROVIDER=gemini only if you choose to use its quota/billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI alternative. Set ASSISTANT_AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
