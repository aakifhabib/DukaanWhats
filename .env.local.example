# Supabase project credentials (keep server-only keys private)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-side only (admin user data + validated store analytics). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated Supabase Auth email addresses allowed into /admin/payments.
ADMIN_EMAILS=your-admin@example.com
